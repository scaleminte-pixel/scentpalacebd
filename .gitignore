# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
*.next.config.*
*next.config.compiled.js

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem
.vscode/
.idea/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# database temporary write-ahead logs
prisma/*.db-journal
prisma/*.db-shm
prisma/*.db-wal
*.db-journal
*.db-shm
*.db-wal

# env files
.env*.local
.env.development
.env.test

# teamwork
.agents/

# typescript
*.tsbuildinfo
next-env.d.ts
