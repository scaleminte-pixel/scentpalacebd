# Copy to .env (local) or set these as Environment Variables in your hosting panel.
# NEVER commit real secret values. ADMIN_SESSION_SECRET/JWT_SECRET can stay empty (auto-generated per server).

# Database Connection (SQLite local file)
DATABASE_URL="file:./dev.db"

# Admin Authentication & Session Secrets
ADMIN_SESSION_SECRET=""
JWT_SECRET=""

# Server Base URL
NEXT_PUBLIC_SITE_URL="https://scentpalacebd.com"

# bKash Merchant Payment Gateway (Sandbox Simulation Mode)
BKASH_MODE="sandbox"
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""

# Courier Provider Integrations
STEADFAST_BASE_URL="https://portal.packzy.com/api/v1"
STEADFAST_API_KEY=""
STEADFAST_SECRET_KEY=""

PATHAO_BASE_URL="https://courier.pathao.com/api/v1"
PATHAO_CLIENT_ID=""
PATHAO_CLIENT_SECRET=""
PATHAO_USERNAME=""
PATHAO_PASSWORD=""

# SMS Gateway
SMS_GATEWAY_URL="https://api.sms-provider-bd.com/send"
SMS_GATEWAY_API_KEY=""
SMS_SENDER_ID=""

# Timezone
TIMEZONE="Asia/Dhaka"

