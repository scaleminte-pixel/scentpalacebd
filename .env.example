# ==============================================================================
# RĀWDAH HAUTE PARFUMERIE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Connection (Default: SQLite for local zero-config execution; switch to PostgreSQL in production)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql://rawdah_user:secure_password@localhost:5432/rawdah_luxury?schema=public"

# Admin Authentication & Session Secrets
ADMIN_SESSION_SECRET="rawdah_luxury_haute_parfumerie_secret_key_2026_dhaka"
JWT_SECRET="rawdah_jwt_token_secret_extraits_sultans_2026"

# Server Base URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# bKash Merchant Payment Gateway (Official Sandbox & Live Configuration)
# Mode: "sandbox" or "live"
BKASH_MODE="sandbox"
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"
BKASH_APP_KEY="sandbox_app_key_rawdah_atelier"
BKASH_APP_SECRET="sandbox_app_secret_rawdah_atelier_2026"
BKASH_USERNAME="sandbox_username_rawdah"
BKASH_PASSWORD="sandbox_password_rawdah"

# Courier Provider Integrations
# Steadfast Courier (Primary Bangladesh Courier)
STEADFAST_BASE_URL="https://portal.steadfast.com.bd/api/v1"
STEADFAST_API_KEY="steadfast_api_key_placeholder"
STEADFAST_SECRET_KEY="steadfast_secret_key_placeholder"

# Pathao Courier (Alternative/Same-Day Dhaka)
PATHAO_BASE_URL="https://courier.pathao.com/api/v1"
PATHAO_CLIENT_ID="pathao_client_id_placeholder"
PATHAO_CLIENT_SECRET="pathao_client_secret_placeholder"
PATHAO_USERNAME="pathao_username_placeholder"
PATHAO_PASSWORD="pathao_password_placeholder"

# SMS Gateway (Transactional Order Notifications)
SMS_GATEWAY_URL="https://api.sms-provider-bd.com/send"
SMS_GATEWAY_API_KEY="sms_api_key_placeholder"
SMS_SENDER_ID="RAWDAH"

# Timezone Setting (Official reporting timezone)
TIMEZONE="Asia/Dhaka"

