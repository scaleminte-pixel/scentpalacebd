# Database Connection (SQLite local file)
DATABASE_URL="file:./dev.db"

# Admin Authentication & Session Secrets
ADMIN_SESSION_SECRET=""  # leave empty: a random secret is generated per server (prisma/.session-secret). Never commit a real value.
JWT_SECRET=""  # leave empty: a random secret is generated per server (prisma/.session-secret). Never commit a real value.

# Server Base URL
NEXT_PUBLIC_SITE_URL="https://scentpalacebd.com"

# bKash Merchant Payment Gateway (Sandbox Simulation Mode)
BKASH_MODE="sandbox"
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"
BKASH_APP_KEY="sandbox_app_key_rawdah_atelier"
BKASH_APP_SECRET="sandbox_app_secret_rawdah_atelier_2026"
BKASH_USERNAME="sandbox_username_rawdah"
BKASH_PASSWORD="sandbox_password_rawdah"

# Courier Provider Integrations
STEADFAST_BASE_URL="https://portal.steadfast.com.bd/api/v1"
STEADFAST_API_KEY="none"
STEADFAST_SECRET_KEY="none"

PATHAO_BASE_URL="https://courier.pathao.com/api/v1"
